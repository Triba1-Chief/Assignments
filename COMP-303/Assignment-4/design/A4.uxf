    <panel_attributes>Note..
onSubmitArticle(hashTag,text)
    article = new ArticleModel(hashTag,text)
    store.addArticle(article)
bg=YELLOW</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>84</x>
      <y>216</y>
      <w>120</w>
      <h>54</h>
    </coordinates>
    <panel_attributes>Note..
addArticle(article):
    articles.add(article)
    notifySubscribers(article)
bg=YELLOW</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>612</x>
      <y>666</y>
      <w>168</w>
      <h>48</h>
    </coordinates>
    <panel_attributes>Note..
onSubmitSubscription(hashtag, email):
    observer = new Consumer(email)
    store.addSubscriber(hashTag, observer)
bg=YELLOW</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>66</x>
      <y>132</y>
      <w>162</w>
      <h>60</h>
    </coordinates>
    <panel_attributes>Note..
addSubscriber(hashtag,consumer):
	if hashtag not in subscriptions:
		subscriptions[hashtag] = new List()
	subscriptions[hashtag].add(consumer)
bg=YELLOW</panel_attributes>
    <additional_attributes/>
  </element>
  <element>
    <id>UMLNote</id>
    <coordinates>
      <x>66</x>
      <y>594</y>
      <w>228</w>
      <h>48</h>
    </coordinates>
    <panel_attributes>Note..
update(article):
    EmailClient.send(this.getEmail(),article.getInfo())
bg=YELLOW</panel_attributes>
